# Copy to .env (or run `npm run init-env`, which also generates a token).
API_TOKEN=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=8787
# MOCK=true serves fake phones (no Mac/iPhones needed)
MOCK=false
MOCK_PHONES=4
# Path to the WebDriverAgent checkout (Appium's copy is fine, see README)
WDA_PROJECT=
# derivedData where scripts/build-wda.sh built the signed runner
WDA_DERIVED_DATA=~/wda-build
WDA_BASE_PORT=8100
MJPEG_BASE_PORT=9100
POLL_MS=5000
AUTOSTART_WDA=true
# Minutes between GitHub update checks (0 = off). Needs the launchd service (KeepAlive) to restart.
AUTO_UPDATE_MINUTES=5
