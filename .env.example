# Copy to .env (or run `npm run init-env`, which also generates a token).
API_TOKEN=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=8787
# MOCK=true serves fake phones (no Mac/iPhones needed)
MOCK=false
MOCK_PHONES=4
# Path to the WebDriverAgent checkout (Appium's copy is fine, see README)
WDA_PROJECT=
# derivedData where scripts/build-wda.sh built the signed runner
WDA_DERIVED_DATA=~/wda-build
WDA_BASE_PORT=8100
MJPEG_BASE_PORT=9100
POLL_MS=5000
AUTOSTART_WDA=true
# Minutes between GitHub update checks (0 = off). Needs the launchd service (KeepAlive) to restart.
AUTO_UPDATE_MINUTES=5
# H.264 live view through native/phonecap (macOS; built by npm run build). false = MJPEG only.
H264=true
H264_BITRATE_MBPS=8
# Input (README "Input"): CoreDevice HID live touch on iOS 27+ phones (auto | on | off)
HID_INPUT=auto
# The Python that has pymobiledevice3 (default ~/.phonefarm-hid/bin/python if it exists, else python3)
# HID_PYTHON=
# Seconds with no viewer/input before a phone's touch session closes (frees its camera/mic)
HID_IDLE_SECONDS=120
# WDA re-sign every 6 days (free Apple ID profiles last 7): the Apple Team ID build-wda.sh signs with
WDA_TEAM_ID=
WDA_RESIGN=true
# local hour the 3-hour quiet re-sign window starts
WDA_RESIGN_HOUR=3
# Rotation and landscape touch (README "Orientation and coordinates"). HID in landscape: on | swap | off
# HID_LANDSCAPE=on
# 1 = the fast WDA route in landscape too (check a landscape tap on the Mac first)
# WDA_FAST_LANDSCAPE=0
# Only if a picture stays sideways after the phone turns: cw | ccw (or 90 | 180 | 270 = always turn it)
# CAPTURE_ROTATE=off
