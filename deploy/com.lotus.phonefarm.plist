<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lotus.phonefarm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>dist/index.js</string>
  </array>
  <!-- edit to where you cloned the project -->
  <key>WorkingDirectory</key><string>/Users/YOURUSER/phone-farm-server</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>DEVELOPER_DIR</key><string>/Applications/Xcode.app/Contents/Developer</string>
  </dict>
  <!-- a user LaunchAgent in the logged-in GUI (Aqua) session: needed for the login keychain (WDA signing) and so the
       capture helper's Camera (TCC) permission applies. Install in ~/Library/LaunchAgents, never /Library/LaunchDaemons. -->
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- 2026-11-21: a crash is restarted after 10 s (never in a tight loop); a stop waits up to 30 s for the server to end
       the WDA runners itself (it exits by 20 s); open files raised from launchd's 256 (sockets, pipes, iproxy forwards) -->
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>30</integer>
  <key>SoftResourceLimits</key>
  <dict><key>NumberOfFiles</key><integer>8192</integer></dict>
  <key>HardResourceLimits</key>
  <dict><key>NumberOfFiles</key><integer>8192</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOURUSER/phone-farm-server/server.log</string>
  <key>StandardErrorPath</key><string>/Users/YOURUSER/phone-farm-server/server.log</string>
</dict>
</plist>
